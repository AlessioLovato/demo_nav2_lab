<?xml version="1.0"?>
<robot name="demo_nav2_lab_mesh">
  <link name="map" />
  <link name="lab_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="1.0"
        ixy="0.0"
        ixz="0.0"
        iyy="1.0"
        iyz="0.0"
        izz="1.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://demo_nav2_lab/mesh/blk360/blk360_from_e57.obj"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://demo_nav2_lab/mesh/blk360/blk360_from_e57.obj"/>
      </geometry>
    </collision>
  </link>
  <joint name="map_to_lab_link" type="fixed">
    <parent link="map" />
    <child link="lab_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
</robot>
